environment=development
CREWAI_TRACING_ENABLED=false
OPENAI_API_KEY=Your-OpenAI-API-Key-Here
OPENAI_API_MODEL=gpt-4o-mini
APP_NAME=Weather AI API
APP_VERSION=1.0.0
WEATHER_API_URL=https://wttr.in
WEATHER_TIMEOUT_SECONDS=10

GOOGLE_API_KEY=Your-Google-API-Key-Here
GOOGLE_ADK_MODEL=gemini-3.5-flash-lite

# Optional Langfuse observability
LANGFUSE_PUBLIC_KEY=Your-Langfuse-Public-Key-Here
LANGFUSE_SECRET_KEY=Your-Langfuse-Secret-Key-Here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

LANGFUSE_SECRET_KEY=Langfuse-Secret-Key-Here
LANGFUSE_PUBLIC_KEY=Langfuse-Public-Key-Here
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
